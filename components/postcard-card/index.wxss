.postcard{position:relative;height:300rpx;border-radius:28rpx;overflow:hidden;background:#ddd}.postcard image,.shade{position:absolute;inset:0;width:100%;height:100%}.shade{background:linear-gradient(180deg,transparent 30%,rgba(20,17,20,.7))}.meta{position:absolute;left:22rpx;right:22rpx;bottom:20rpx;color:#fff}.from{font-size:18rpx;letter-spacing:2rpx}.message{margin-top:8rpx;font-size:24rpx;line-height:1.45}
