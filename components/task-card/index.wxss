.task-card { display:flex; align-items:center; gap:18rpx; padding:24rpx; border-radius:26rpx; background:#fff; box-shadow:0 10rpx 32rpx rgba(77,54,40,.06); }
.task-card:active { transform:scale(.99); }.task-card.completed { opacity:.65; }.task-check { display:flex; align-items:center; justify-content:center; width:54rpx; height:54rpx; border-radius:50%; background:#fff1e6; color:#e66c18; font-size:30rpx; font-weight:700; }.task-main { flex:1; min-width:0; }.task-title { font-size:27rpx; font-weight:700; color:#332a26; }.task-desc { margin-top:6rpx; color:#978a82; font-size:21rpx; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }.task-reward { color:#e66c18; font-size:23rpx; font-weight:700; }
