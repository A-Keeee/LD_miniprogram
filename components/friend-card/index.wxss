.friend-card { display:flex; align-items:center; gap:18rpx; padding:20rpx; border-radius:28rpx; background:#fff; box-shadow:0 12rpx 34rpx rgba(77,54,40,.07); }.friend-card:active{transform:scale(.99)}.friend-avatar{width:96rpx;height:96rpx;border-radius:24rpx}.friend-info{flex:1;min-width:0}.friend-name{font-size:29rpx;font-weight:750;color:#2d2521}.friend-tags{margin-top:8rpx;color:#958880;font-size:21rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.match{color:#e66c18;font-size:36rpx;font-weight:800}.match text{font-size:20rpx}
