<view class="container auth-page">
  <view class="nav-back" bindtap="goLogin">‹ 返回登录</view>

  <view class="header">
    <view class="icon-wrap">
      <t-icon name="sparkles" size="32px" color="#9333ea" />
    </view>
    <view class="title">创建账号</view>
    <view class="subtitle">注册后可在设置页绑定设备，并为每台设备创建专属宠物</view>
  </view>

  <view class="form">
    <view class="form-group">
      <view class="label">手机号</view>
      <input
        class="input-text"
        type="number"
        maxlength="11"
        placeholder="请输入手机号"
        value="{{phoneNumber}}"
        bindinput="onPhoneInput"
      />
    </view>

    <view class="form-group">
      <view class="label">密码</view>
      <input
        class="input-text"
        password
        placeholder="至少 6 位"
        value="{{password}}"
        bindinput="onPasswordChange"
      />
    </view>

    <view class="agree-row" bindtap="toggleAgree">
      <view class="agree-box {{isCheck ? 'agree-box--on' : ''}}">
        <text wx:if="{{isCheck}}" class="agree-check">✓</text>
      </view>
      <text class="agree-text">同意《协议条款》</text>
    </view>

    <button class="submit-btn" disabled="{{!isSubmit}}" bindtap="submit">注册</button>

    <view class="auth-footer-link" bindtap="goLogin">已有账号？去登录</view>
  </view>
</view>
