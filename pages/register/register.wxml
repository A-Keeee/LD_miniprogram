<view class="container auth-page">
  <view class="nav-back" bindtap="goLogin">‹ 返回登录</view>

  <view class="header">
    <view class="icon-wrap">
      <t-icon name="sparkles" size="32px" color="#9333ea" />
    </view>
    <view class="title">创建账号</view>
    <view class="subtitle">创建专属于你的宠物的数字分身，跨越时空陪伴</view>
  </view>

  <view class="form">
    <view class="form-group">
      <view class="label">手机号</view>
      <input
        class="input-text"
        type="number"
        maxlength="11"
        placeholder="请输入手机号"
        value="{{phoneNumber}}"
        bindinput="onPhoneInput"
      />
    </view>

    <view class="form-group">
      <view class="label">密码</view>
      <input
        class="input-text"
        password
        placeholder="至少 6 位"
        value="{{password}}"
        bindinput="onPasswordChange"
      />
    </view>

    <view class="form-group">
      <view class="label">爱宠昵称</view>
      <input class="input-text" placeholder="例如：糯米" value="{{name}}" bindinput="onNameInput" />
    </view>

    <view class="type-selector">
      <view class="type-btn {{type === 'cat' ? 'active' : ''}}" data-type="cat" bindtap="selectType">
        <text class="emoji">🐱</text>
        <text>猫咪</text>
      </view>
      <view class="type-btn {{type === 'dog' ? 'active' : ''}}" data-type="dog" bindtap="selectType">
        <text class="emoji">🐶</text>
        <text>狗狗</text>
      </view>
    </view>

    <view class="form-group">
      <view class="label">上传照片 (用于生成数字分身)</view>
      <view class="upload-area" bindtap="chooseImage">
        <image wx:if="{{image}}" src="{{image}}" mode="aspectFill" class="preview-img"></image>
        <view wx:else class="upload-placeholder">
          <t-icon name="upload" size="32px" color="#9ca3af" />
          <text>点击上传照片</text>
        </view>
      </view>
    </view>

    <view class="agree-row" bindtap="toggleAgree">
      <view class="agree-box {{isCheck ? 'agree-box--on' : ''}}">
        <text wx:if="{{isCheck}}" class="agree-check">✓</text>
      </view>
      <text class="agree-text">同意《协议条款》</text>
    </view>

    <button class="submit-btn" disabled="{{!isSubmit}}" bindtap="submit">注册</button>

    <view class="auth-footer-link" bindtap="goLogin">已有账号？去登录</view>
  </view>
</view>
