page{background:#f7f4ee;color:#211b18}.social-page{min-height:100vh;padding:38rpx 28rpx 180rpx;box-sizing:border-box}.eyebrow{color:#8b5cf6;font-size:22rpx;font-weight:700}.title{margin-top:10rpx;font-size:46rpx;font-weight:780;line-height:1.25}.subtitle{margin-top:12rpx;color:#897c75;font-size:25rpx}.bump-stage{position:relative;display:flex;align-items:center;justify-content:center;height:390rpx;margin-top:30rpx;border-radius:38rpx;background:linear-gradient(145deg,#fff4e8,#f0eafe);overflow:hidden}.pet-orb{position:absolute;top:70rpx;display:flex;flex-direction:column;align-items:center;gap:12rpx;transition:transform .6s ease}.pet-orb.left{left:34rpx}.pet-orb.right{right:34rpx;filter:saturate(.5);opacity:.72}.matched .pet-orb.right{filter:none;opacity:1}.scanning .pet-orb.left,.matched .pet-orb.left{transform:translateX(38rpx)}.scanning .pet-orb.right,.matched .pet-orb.right{transform:translateX(-38rpx)}.pet-orb image{width:170rpx;height:210rpx;border:8rpx solid #fff;border-radius:80rpx;box-shadow:0 18rpx 44rpx rgba(82,57,42,.14)}.pet-orb text{font-size:24rpx;font-weight:700}.bump-signal{position:relative;z-index:2;display:flex;align-items:center;justify-content:center;width:78rpx;height:78rpx;border-radius:50%;background:#ff8a34;color:#fff;font-size:25rpx;font-weight:800;box-shadow:0 12rpx 30rpx rgba(255,138,52,.3)}.signal-ring{position:absolute;inset:-20rpx;border:2rpx solid rgba(255,138,52,.35);border-radius:50%}.scanning .signal-ring{animation:pulse 1s ease infinite}.ring-b{animation-delay:.4s!important}@keyframes pulse{from{opacity:1;transform:scale(.7)}to{opacity:0;transform:scale(1.7)}}.bump-button{margin-top:22rpx;border:0;border-radius:999rpx;background:#ff8a34;color:#fff;font-size:28rpx;font-weight:700}.bump-button::after,.match-actions button::after,.friend-sheet button::after{border:0}.shake-hint{text-align:center;margin-top:14rpx;color:#9a8d85;font-size:21rpx}.match-card{margin-top:28rpx;padding:28rpx;border-radius:32rpx;background:#fff;box-shadow:0 12rpx 38rpx rgba(77,54,40,.07)}.match-heading{display:flex;justify-content:space-between;align-items:center}.match-label{color:#8b5cf6;font-size:21rpx;font-weight:700}.match-title{margin-top:6rpx;font-size:31rpx;font-weight:750}.match-score{color:#e66c18;font-size:58rpx;font-weight:850}.match-score text{font-size:24rpx}.trait-row{display:grid;grid-template-columns:60rpx 1fr 90rpx;align-items:center;gap:12rpx;margin-top:20rpx;color:#73665f;font-size:21rpx}.trait-bars{display:flex;flex-direction:column;gap:5rpx}.trait-bar{height:8rpx;border-radius:99rpx;background:#ff9a54}.trait-bar.right{background:#9a78d0}.match-actions{display:grid;grid-template-columns:1fr 1fr;gap:14rpx;margin-top:28rpx}.match-actions button{border:0;border-radius:999rpx;background:#ff8a34;color:#fff;font-size:24rpx}.match-actions button.outline{background:#f2ecf8;color:#7554a0}.saved-section{margin-top:34rpx}.section-title{margin-bottom:16rpx;font-size:31rpx;font-weight:750}.sheet-mask{position:fixed;z-index:100;inset:0;background:rgba(33,27,24,.5)}.friend-sheet{position:fixed;z-index:101;left:22rpx;right:22rpx;bottom:22rpx;padding:32rpx;border-radius:38rpx;background:#fffdf9}.friend-top{display:flex;align-items:center;gap:20rpx}.friend-top image{width:112rpx;height:112rpx;border-radius:28rpx}.friend-name{font-size:36rpx;font-weight:780}.friend-owner{margin-top:7rpx;color:#968980;font-size:22rpx}.tag-row{display:flex;gap:10rpx;margin-top:24rpx}.tag-row text{padding:9rpx 16rpx;border-radius:999rpx;background:#f1eafa;color:#73539a;font-size:21rpx}.story-preview,.full-story{margin-top:24rpx;color:#665950;font-size:26rpx;line-height:1.7}.full-story{padding-top:18rpx;border-top:1rpx solid #eee5df}.friend-sheet button{margin-top:24rpx;border:0;border-radius:999rpx;background:#32283d;color:#fff;font-size:25rpx}.friend-sheet .play-button{background:#ff8a34}
