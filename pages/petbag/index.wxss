page{background:#28222c;color:#fff}.bag-page{min-height:100vh;padding:38rpx 28rpx calc(36rpx + env(safe-area-inset-bottom));box-sizing:border-box}.bag-header{text-align:center}.eyebrow{color:#ffb77f;font-size:19rpx;letter-spacing:4rpx}.title{margin-top:10rpx;font-size:43rpx;font-weight:780}.subtitle{margin-top:10rpx;color:#bdb1c2;font-size:23rpx}.bag-window{position:relative;height:820rpx;margin-top:30rpx;border:10rpx solid rgba(255,255,255,.72);border-radius:120rpx 120rpx 58rpx 58rpx;background:linear-gradient(180deg,rgba(236,220,255,.22),rgba(255,229,203,.17));box-shadow:inset 0 0 80rpx rgba(255,255,255,.12),0 30rpx 70rpx rgba(0,0,0,.25);overflow:hidden}.window-glow{position:absolute;top:-100rpx;left:10%;width:80%;height:400rpx;border-radius:50%;background:radial-gradient(circle,rgba(255,196,144,.3),transparent 68%)}.bag-hole{position:absolute;width:18rpx;height:18rpx;border:4rpx solid rgba(255,255,255,.5);border-radius:50%}.hole-a{top:90rpx;left:70rpx}.hole-b{top:140rpx;right:80rpx}.hole-c{top:230rpx;left:110rpx}.pet-wrap{position:absolute;z-index:2;left:50%;bottom:95rpx;width:520rpx;margin-left:-260rpx;transform-origin:50% 100%;transition:transform .08s linear}.pet-wrap image{display:block;width:100%}.dizzy{position:absolute;top:-26rpx;left:50%;color:#ffd277;font-size:36rpx;transform:translateX(-50%);animation:wobble .25s ease infinite alternate}@keyframes wobble{to{transform:translateX(-50%) rotate(8deg)}}.floor-shadow{position:absolute;left:50%;bottom:80rpx;width:300rpx;height:44rpx;margin-left:-150rpx;border-radius:50%;background:rgba(0,0,0,.28);filter:blur(12rpx);transition:transform .08s linear}.sensor-status{display:flex;align-items:center;justify-content:center;gap:12rpx;margin-top:22rpx;color:#bdb1c2;font-size:21rpx}.sensor-dot{width:13rpx;height:13rpx;border-radius:50%;background:#8d8291}.sensor-dot.ready{background:#72b78b;box-shadow:0 0 0 7rpx rgba(114,183,139,.12)}.demo-controls{display:flex;align-items:center;justify-content:space-between;margin-top:20rpx;padding:16rpx 20rpx;border-radius:22rpx;background:rgba(255,255,255,.08)}.control-hint{color:#bdb1c2;font-size:21rpx}.demo-controls button{width:190rpx;height:62rpx;margin:0;border:0;border-radius:999rpx;background:#4b4051;color:#fff;font-size:22rpx;line-height:62rpx}.demo-controls button::after,.release-button::after{border:0}.release-button{margin-top:22rpx;border:0;border-radius:999rpx;background:#ff8a34;color:#fff;font-size:28rpx;font-weight:700}
