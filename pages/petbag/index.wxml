<view class="bag-page"><view class="bag-header"><view class="eyebrow">PHONE PET BAG</view><view class="title">把汤圆带在身边</view><view class="subtitle">倾斜手机，它会顺着你的方向靠过去。</view></view><view class="bag-window" bindtouchstart="handleTouchStart" catchtouchmove="handleTouchMove"><view class="window-glow"></view><view class="bag-hole hole-a"></view><view class="bag-hole hole-b"></view><view class="bag-hole hole-c"></view><view class="pet-wrap" style="transform:translate3d({{x}}rpx,{{y}}rpx,0) rotate({{rotation}}deg) scale({{scale}});"><image src="/static/demo/tangyuan-sticker.png" mode="widthFix"></image><view class="dizzy" wx:if="{{dizzy}}">✦ ＠ ✦</view></view><view class="floor-shadow" style="transform:translateX({{x * 0.45}}rpx) scale({{scale}});"></view></view><view class="sensor-status"><view class="sensor-dot {{sensorReady ? 'ready' : ''}}"></view><text>{{sensorReady ? '已连接手机传感器' : '传感器不可用，可直接拖动猫咪'}}</text></view><view class="demo-controls" wx:if="{{isDemo}}"><view class="control-hint">开发者工具 fallback</view><button bindtap="simulateShake">模拟摇一摇</button></view><button class="release-button" bindtap="releasePet">放它出来</button></view>
