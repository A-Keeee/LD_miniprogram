<view class="container auth-page">
  <view class="header">
    <view class="icon-wrap">
      <t-icon name="sparkles" size="32px" color="#9333ea" />
    </view>
    <view class="title">欢迎登录</view>
    <view class="subtitle">创建专属于你的宠物的数字分身，跨越时空陪伴</view>
  </view>

  <view class="form">
    <view class="form-group">
      <view class="label">手机号</view>
      <input
        class="input-text"
        type="number"
        maxlength="11"
        placeholder="请输入手机号"
        value="{{phoneNumber}}"
        bindinput="onPhoneInput"
      />
    </view>

    <view class="form-group">
      <view class="label">密码</view>
      <input
        class="input-text"
        password
        placeholder="请输入密码"
        value="{{password}}"
        bindinput="onPasswordChange"
      />
    </view>

    <view class="login-tips">请使用已注册手机号与密码登录；尚无账号请先注册。</view>

    <view class="agree-row" bindtap="toggleAgree">
      <view class="agree-box {{isCheck ? 'agree-box--on' : ''}}">
        <text wx:if="{{isCheck}}" class="agree-check">✓</text>
      </view>
      <text class="agree-text">同意《协议条款》</text>
    </view>

    <button class="submit-btn" disabled="{{!isSubmit}}" bindtap="login">登录</button>

    <view class="auth-footer-link" bindtap="goRegister">还没有账号？去注册</view>
  </view>
</view>
