page { background: #f7f4ee; color: #211b18; }
.journal-page { min-height: 100vh; padding: 32rpx 28rpx 180rpx; box-sizing: border-box; }
.journal-hero { padding: 18rpx 8rpx 28rpx; }
.date { color: #e66c18; font-size: 23rpx; font-weight: 700; }
.title { margin-top: 10rpx; font-size: 52rpx; font-weight: 750; }
.mood { margin-top: 10rpx; color: #81756f; font-size: 26rpx; }
.chart-card,.timeline-card,.dream-card { margin-bottom: 22rpx; padding: 28rpx; border-radius: 30rpx; background: #fff; box-shadow: 0 12rpx 38rpx rgba(77,54,40,.06); }
.card-heading { display: flex; justify-content: space-between; font-size: 29rpx; font-weight: 700; }
.score { color: #e66c18; }
.mood-chart { position: relative; height: 260rpx; margin-top: 22rpx; border-radius: 22rpx; background: linear-gradient(180deg,#fff8ee,#f5f2ff); }
.guide { position: absolute; left: 0; right: 0; height: 1rpx; background: rgba(121,107,99,.12); }
.guide-a { top: 33%; }.guide-b { top: 66%; }
.chart-point { position: absolute; transform: translate(-50%,-50%); }
.dot { width: 18rpx; height: 18rpx; border: 7rpx solid #fff; border-radius: 50%; background: #ff8a34; box-shadow: 0 3rpx 12rpx rgba(230,108,24,.35); }
.point-time { position: absolute; top: 30rpx; left: 50%; color: #9a8d85; font-size: 18rpx; transform: translateX(-50%); white-space: nowrap; }
.dream-card { display: flex; align-items: center; justify-content: space-between; background: linear-gradient(135deg,#30263e,#56436b); color: #fff; }
.dream-kicker { color: #d7c9ea; font-size: 21rpx; }.dream-title { margin-top: 9rpx; font-size: 30rpx; font-weight: 650; }.dream-icon { font-size: 70rpx; color: #ffdca8; }
.timeline-item { display: flex; gap: 18rpx; padding: 26rpx 0; border-bottom: 1rpx solid #f1ebe6; }
.timeline-icon { display: flex; align-items: center; justify-content: center; width: 62rpx; height: 62rpx; border-radius: 20rpx; background: #fff3e8; font-size: 30rpx; }
.timeline-body { flex: 1; min-width: 0; }.timeline-meta { display: flex; justify-content: space-between; font-size: 24rpx; font-weight: 650; }.source { color: #a2958e; font-size: 19rpx; font-weight: 400; }.timeline-thought { margin-top: 10rpx; color: #70635c; font-size: 25rpx; line-height: 1.55; }.empty { padding: 50rpx 0; text-align: center; color: #a2958e; }
.journal-button,.story-sheet button { margin-top: 24rpx; border: 0; border-radius: 999rpx; background: #ff8a34; color: #fff; font-size: 28rpx; font-weight: 650; }.journal-button::after,.story-sheet button::after { border: 0; }.saved-link { padding: 24rpx; text-align: center; color: #e66c18; font-size: 25rpx; }
.sheet-mask { position: fixed; z-index: 100; inset: 0; background: rgba(33,27,24,.5); }.story-sheet { position: fixed; z-index: 101; left: 24rpx; right: 24rpx; bottom: 24rpx; padding: 38rpx; border-radius: 38rpx; background: #fffdf9; box-sizing: border-box; }.sheet-kicker { color: #8b5cf6; font-size: 22rpx; font-weight: 700; }.sheet-title { margin-top: 10rpx; font-size: 38rpx; font-weight: 750; }.story-text,.journal-text { margin-top: 26rpx; color: #5f524b; font-size: 28rpx; line-height: 1.9; white-space: pre-wrap; }
