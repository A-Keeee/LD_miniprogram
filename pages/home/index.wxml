<view class="home-page" wx:if="{{pet}}">
  <view class="home-header">
    <view>
      <view class="eyebrow">今天也在陪着你</view>
      <view class="pet-name">{{pet.name}}</view>
      <view class="status-line"><view class="online-dot"></view>{{statusConfig[pet.currentStatus].label}} · 刚刚</view>
    </view>
    <view class="header-side">
      <view class="demo-pill" wx:if="{{isDemo}}">DEMO</view>
      <view class="points-pill">🧡 {{points}}</view>
    </view>
  </view>

  <scroll-view wx:if="{{devices.length > 1}}" class="pet-picker" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="pet-picker-inner">
      <view wx:for="{{devices}}" wx:key="device_id" class="pet-picker-item {{item.device_id === activeDeviceId ? 'active' : ''}}" data-id="{{item.device_id}}" bindtap="handleSelectPet">
        <image wx:if="{{item.thumb}}" src="{{item.thumb}}" class="pet-picker-avatar" mode="aspectFill"></image>
        <view wx:else class="pet-picker-avatar pet-picker-placeholder">{{item.petType === 'dog' ? '🐶' : '🐱'}}</view>
        <text>{{item.displayName}}</text>
      </view>
    </view>
  </scroll-view>

  <view class="visual-card {{isPetting ? 'is-petting' : ''}}">
    <video wx:if="{{videoSrc && !videoError && !videoDisabled}}" src="{{videoSrc}}" http-header="{{videoHttpHeader}}" class="pet-media" autoplay loop muted object-fit="cover" controls="{{false}}" show-center-play-btn="{{false}}" show-play-btn="{{false}}" show-fullscreen-btn="{{false}}" show-progress="{{false}}" enable-progress-gesture="{{false}}" binderror="handleVideoError"></video>
    <image wx:else src="{{pet.baseImage}}" mode="aspectFill" class="pet-media"></image>
    <view class="visual-shade"></view>
    <view class="media-label">{{videoSrc && !videoError && !videoDisabled ? '状态影像' : '数字分身'}}</view>
    <view class="mood-pill">{{statusConfig[pet.currentStatus].icon}} {{moodLabel}} · {{moodScore}}</view>
    <view class="heart-pop" wx:if="{{isPetting}}">♥</view>
  </view>

  <view class="thought-card">
    <view class="thought-kicker">它在想</view>
    <view class="thought-text">“{{thought}}”</view>
  </view>

  <view class="quick-actions">
    <button class="quick-action primary" bindtap="openPetBag"><text class="action-emoji">🎒</text><text>装进猫包</text></button>
    <button class="quick-action" bindtap="triggerHaptic"><text class="action-emoji">🧡</text><text>摸摸它</text></button>
    <button class="quick-action" bindtap="toggleChat"><text class="action-emoji">💬</text><text>和它聊聊</text></button>
  </view>

  <view class="today-card" bindtap="openJournal">
    <view class="section-row"><view><view class="section-title">汤圆的今天</view><view class="section-subtitle">每个瞬间都被好好记住</view></view><text class="link-arrow">查看手帐 →</text></view>
    <view class="today-stats">
      <view class="today-stat"><text class="stat-value">{{todayStats.activeMinutes}}</text><text class="stat-label">活跃分钟</text></view>
      <view class="today-stat"><text class="stat-value">{{todayStats.restText}}</text><text class="stat-label">休息时长</text></view>
      <view class="today-stat"><text class="stat-value">{{todayStats.eventCount}}</text><text class="stat-label">今日瞬间</text></view>
    </view>
  </view>

  <view class="task-section" wx:if="{{featuredTask}}"><view class="section-row task-heading"><view class="section-title">今日任务</view><view class="task-progress">{{tasks.length}} 项陪伴计划</view></view><task-card task="{{featuredTask}}" bind:select="handleTaskSelect" /></view>

  <view class="sheet-mask" wx:if="{{showTaskSheet}}" bindtap="closeTaskSheet"></view>
  <view class="task-sheet" wx:if="{{showTaskSheet}}">
    <view class="sheet-handle"></view>
    <view class="sheet-title">{{taskSheetType === 'scene' ? '告诉我你看见了什么' : '你今天感觉怎么样？'}}</view>
    <button wx:if="{{taskSheetType === 'scene'}}" class="photo-button" bindtap="chooseScenePhoto">拍摄或选择一张照片</button>
    <view class="preset-grid" wx:if="{{taskSheetType === 'scene'}}"><view wx:for="{{scenePresets}}" wx:key="*this" class="preset-item" data-label="{{item}}" bindtap="selectScenePreset">{{item}}</view></view>
    <view class="preset-grid mood-grid" wx:else><view wx:for="{{moodPresets}}" wx:key="*this" class="preset-item" data-mood="{{item}}" bindtap="selectOwnerMood">{{item}}</view></view>
  </view>

  <view class="chat-overlay" wx:if="{{showChat}}" catchtouchmove="preventScroll">
    <view class="chat-mask" bindtap="toggleChat"></view>
    <view class="chat-modal">
      <view class="chat-header"><view class="chat-pet-info"><image src="{{pet.baseImage}}" class="chat-avatar" mode="aspectFill"></image><view><view class="chat-name">和 {{pet.name}} 聊聊</view><view class="chat-status-badge">{{moodLabel}}</view></view></view><view class="close-btn" bindtap="toggleChat">×</view></view>
      <scroll-view class="chat-messages" scroll-y scroll-top="{{scrollTop}}" enhanced show-scrollbar="{{false}}">
        <view class="chat-empty" wx:if="{{chatHistory.length === 0}}"><view class="chat-empty-icon">💭</view><text>它正在等你说点什么</text></view>
        <view wx:for="{{chatHistory}}" wx:key="index" class="message-row {{item.sender}}"><view class="message-bubble">{{item.text}}</view></view>
        <view class="message-row pet" wx:if="{{isTyping}}"><view class="message-bubble">正在想…</view></view>
      </scroll-view>
      <view class="chat-input-area"><view class="input-box"><input class="chat-input" placeholder="说点什么…" value="{{chatMessage}}" bindinput="handleChatInput" confirm-type="send" bindconfirm="sendMessage"/><button class="send-btn" disabled="{{!chatMessage}}" bindtap="sendMessage">发送</button></view></view>
    </view>
  </view>
</view>

<view class="home-empty" wx:else><view class="empty-emoji">🐾</view><view>正在准备你的数字伙伴…</view></view>
