page { background: #f7f4ee; color: #211b18; }
.home-page { min-height: 100vh; padding: 28rpx 28rpx 180rpx; box-sizing: border-box; }
.home-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 24rpx; }
.eyebrow { color: #9a8d85; font-size: 22rpx; letter-spacing: 2rpx; }
.pet-name { margin-top: 6rpx; font-size: 52rpx; line-height: 1.15; font-weight: 750; }
.status-line { display: flex; align-items: center; margin-top: 10rpx; color: #756a64; font-size: 25rpx; }
.online-dot { width: 13rpx; height: 13rpx; margin-right: 10rpx; border-radius: 50%; background: #72b78b; box-shadow: 0 0 0 7rpx rgba(114,183,139,.12); }
.header-side { display: flex; flex-direction: column; align-items: flex-end; gap: 10rpx; }
.demo-pill, .points-pill { border-radius: 999rpx; background: #fff; padding: 10rpx 18rpx; color: #8b5cf6; font-size: 21rpx; font-weight: 700; box-shadow: 0 8rpx 28rpx rgba(77,54,40,.07); }
.points-pill { color: #e66c18; font-size: 24rpx; }
.pet-picker { width: 100%; margin-bottom: 18rpx; white-space: nowrap; }
.pet-picker-inner { display: inline-flex; gap: 14rpx; }
.pet-picker-item { display: inline-flex; align-items: center; gap: 10rpx; padding: 8rpx 14rpx 8rpx 8rpx; border-radius: 999rpx; background: #fff; color: #80736c; font-size: 22rpx; }
.pet-picker-item.active { color: #e66c18; box-shadow: inset 0 0 0 2rpx #ffb27c; }
.pet-picker-avatar { display: flex; align-items: center; justify-content: center; width: 52rpx; height: 52rpx; border-radius: 50%; }
.pet-picker-placeholder { background: #fff1e6; }
.visual-card { position: relative; width: 100%; height: 760rpx; overflow: hidden; border-radius: 44rpx; background: #eadfd6; box-shadow: 0 24rpx 54rpx rgba(91,58,38,.14); transform: scale(1); transition: transform .25s ease; }
.visual-card.is-petting { transform: scale(.975); }
.pet-media { width: 100%; height: 100%; }
.visual-shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(33,27,24,.03) 55%, rgba(33,27,24,.4)); pointer-events: none; }
.media-label { position: absolute; top: 24rpx; left: 24rpx; padding: 9rpx 16rpx; border-radius: 999rpx; background: rgba(255,255,255,.84); color: #655850; font-size: 21rpx; backdrop-filter: blur(12rpx); }
.mood-pill { position: absolute; left: 24rpx; bottom: 24rpx; padding: 14rpx 20rpx; border-radius: 999rpx; background: rgba(255,255,255,.9); font-size: 25rpx; font-weight: 600; }
.heart-pop { position: absolute; top: 44%; left: 50%; color: #ff6b7d; font-size: 90rpx; animation: heart-pop .8s ease both; }
@keyframes heart-pop { 0% { opacity: 0; transform: translate(-50%, 20rpx) scale(.3); } 35% { opacity: 1; transform: translate(-50%, -10rpx) scale(1.15); } 100% { opacity: 0; transform: translate(-50%, -100rpx) scale(.8); } }
.thought-card, .today-card { margin-top: 24rpx; padding: 28rpx; border-radius: 30rpx; background: #fff; box-shadow: 0 12rpx 40rpx rgba(77,54,40,.06); }
.thought-card { background: linear-gradient(135deg, #fff 0%, #fff5eb 100%); }
.thought-kicker { color: #e66c18; font-size: 22rpx; font-weight: 700; letter-spacing: 2rpx; }
.thought-text { margin-top: 12rpx; color: #392f2b; font-size: 31rpx; line-height: 1.65; font-weight: 550; }
.quick-actions { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14rpx; margin-top: 20rpx; }
.quick-action { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 126rpx; margin: 0; padding: 0; border: 0; border-radius: 26rpx; background: #fff; color: #574b45; font-size: 23rpx; line-height: 1.2; box-shadow: 0 10rpx 28rpx rgba(77,54,40,.05); }
.quick-action::after { border: 0; }
.quick-action.primary { background: #ff8a34; color: #fff; }
.quick-action:active { transform: translateY(2rpx) scale(.98); opacity: .9; }
.action-emoji { margin-bottom: 9rpx; font-size: 36rpx; }
.section-row { display: flex; justify-content: space-between; align-items: center; }
.section-title { font-size: 31rpx; font-weight: 700; }
.section-subtitle { margin-top: 6rpx; color: #998c84; font-size: 22rpx; }
.link-arrow { color: #e66c18; font-size: 23rpx; }
.today-stats { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 26rpx; padding-top: 24rpx; border-top: 1rpx solid #f0e9e3; }
.today-stat { display: flex; flex-direction: column; align-items: center; }
.stat-value { font-size: 31rpx; font-weight: 750; }
.stat-label { margin-top: 7rpx; color: #998c84; font-size: 21rpx; }
.task-section { margin-top:30rpx; }.task-heading { margin-bottom:16rpx; padding:0 4rpx; }.task-progress { color:#a2958e; font-size:21rpx; }
.sheet-mask { position:fixed; z-index:90; inset:0; background:rgba(33,27,24,.46); }.task-sheet { position:fixed; z-index:91; left:0; right:0; bottom:0; padding:18rpx 28rpx calc(38rpx + env(safe-area-inset-bottom)); border-radius:38rpx 38rpx 0 0; background:#fffdf9; }.sheet-handle { width:70rpx; height:8rpx; margin:0 auto 28rpx; border-radius:99rpx; background:#ded5cf; }.sheet-title { font-size:34rpx; font-weight:750; }.photo-button { margin:26rpx 0 18rpx; border:0; border-radius:999rpx; background:#ff8a34; color:#fff; font-size:26rpx; }.photo-button::after { border:0; }.preset-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:14rpx; margin-top:22rpx; }.mood-grid { grid-template-columns:repeat(2,1fr); }.preset-item { padding:24rpx 12rpx; border-radius:20rpx; background:#f7f2ec; text-align:center; color:#5f524b; font-size:25rpx; }.preset-item:active { background:#fff0e4; color:#e66c18; }
.home-empty { display: flex; min-height: 100vh; flex-direction: column; align-items: center; justify-content: center; background: #f7f4ee; color: #81756f; }
.empty-emoji { margin-bottom: 20rpx; font-size: 72rpx; }
.chat-overlay { position: fixed; z-index: 1000; inset: 0; }
.chat-mask { position: absolute; inset: 0; background: rgba(33,27,24,.45); }
.chat-modal { position: absolute; left: 0; right: 0; bottom: 0; height: 72vh; display: flex; flex-direction: column; border-radius: 38rpx 38rpx 0 0; background: #faf8f4; overflow: hidden; }
.chat-header { display: flex; align-items: center; justify-content: space-between; padding: 25rpx 28rpx; background: #fff; }
.chat-pet-info { display: flex; align-items: center; gap: 18rpx; }
.chat-avatar { width: 72rpx; height: 72rpx; border-radius: 50%; }
.chat-name { font-size: 29rpx; font-weight: 700; }
.chat-status-badge { margin-top: 5rpx; color: #9a8d85; font-size: 21rpx; }
.close-btn { padding: 10rpx; color: #81756f; font-size: 42rpx; }
.chat-messages { flex: 1; height: 0; padding: 24rpx; box-sizing: border-box; }
.chat-empty { display: flex; flex-direction: column; align-items: center; margin-top: 120rpx; color: #9a8d85; font-size: 25rpx; }
.chat-empty-icon { margin-bottom: 16rpx; font-size: 54rpx; }
.message-row { display: flex; margin-bottom: 18rpx; }
.message-row.user { justify-content: flex-end; }
.message-bubble { max-width: 70%; padding: 18rpx 22rpx; border-radius: 24rpx; background: #fff; font-size: 27rpx; line-height: 1.5; }
.message-row.user .message-bubble { background: #ff8a34; color: #fff; }
.chat-input-area { padding: 18rpx 22rpx calc(18rpx + env(safe-area-inset-bottom)); background: #fff; }
.input-box { display: flex; align-items: center; gap: 14rpx; padding: 8rpx 8rpx 8rpx 24rpx; border-radius: 999rpx; background: #f4f0eb; }
.chat-input { flex: 1; font-size: 27rpx; }
.send-btn { width: 112rpx; margin: 0; border: 0; border-radius: 999rpx; background: #ff8a34; color: #fff; font-size: 24rpx; }
.send-btn::after { border: 0; }
