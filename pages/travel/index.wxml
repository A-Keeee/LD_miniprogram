<view class="travel-page"><view class="travel-header"><view class="eyebrow">世界副本 · FRONTEND DEMO</view><view class="title">让汤圆替你看看世界</view><view class="subtitle">一场由本地状态机驱动的数字旅行</view><view class="points">🧡 {{points}} 积分</view></view>
<view class="journey-card" wx:if="{{session && session.status === 'traveling'}}"><image src="{{session.destinationData.cover}}" mode="aspectFill"></image><view class="journey-shade"></view><view class="journey-info"><view class="journey-label">旅途中 · {{session.progress}}%</view><view class="journey-title">{{session.destination}}</view><view class="progress-track"><view class="progress-fill" style="width:{{session.progress}}%"></view></view><view class="message">“{{session.message}}”</view></view></view>
<view class="section-title">选择目的地</view><view class="destination-list"><view wx:for="{{destinations}}" wx:key="id" class="destination-card"><image src="{{item.cover}}" mode="aspectFill"></image><view class="destination-body"><view class="destination-name">{{item.name}}</view><view class="destination-meta">约 {{item.duration}} 秒 · 可能带回 {{item.souvenir.name}}</view><button data-id="{{item.id}}" bindtap="start" disabled="{{session && session.status === 'traveling'}}">50 积分出发</button></view></view></view>
<view class="section-title" wx:if="{{postcards.length}}">收到的明信片</view><view class="postcard-grid"><postcard-card wx:for="{{postcards}}" wx:key="id" postcard="{{item}}" bind:open="openPostcard" /></view>
<view class="section-title" wx:if="{{souvenirs.length}}">带回的数字特产</view><scroll-view class="souvenir-row" scroll-x><view class="souvenir" wx:for="{{souvenirs}}" wx:key="id"><image src="{{item.image}}" mode="aspectFill"></image><text>{{item.name}}</text></view></scroll-view></view>
<view class="postcard-mask" wx:if="{{showPostcard}}" bindtap="closePostcard"></view><view class="postcard-sheet" wx:if="{{showPostcard}}"><image src="{{activePostcard.cover}}" mode="aspectFill"></image><view class="postcard-copy"><view class="to">TO：你　 FROM：汤圆</view><view class="postcard-message">“{{activePostcard.message}}”</view><button open-type="share">分享给朋友</button><button class="close" bindtap="closePostcard">收进收藏</button></view></view>
