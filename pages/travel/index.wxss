page{background:#f7f4ee;color:#211b18}.travel-page{min-height:100vh;padding:36rpx 28rpx 180rpx;box-sizing:border-box}.travel-header{position:relative;padding:12rpx 4rpx 30rpx}.eyebrow{color:#8b5cf6;font-size:21rpx;font-weight:700;letter-spacing:1rpx}.title{margin-top:10rpx;font-size:46rpx;font-weight:780;line-height:1.25}.subtitle{margin-top:12rpx;color:#897c75;font-size:24rpx}.points{position:absolute;right:4rpx;top:10rpx;padding:10rpx 16rpx;border-radius:999rpx;background:#fff;color:#e66c18;font-size:22rpx;font-weight:700}.journey-card{position:relative;height:390rpx;margin-bottom:30rpx;border-radius:34rpx;overflow:hidden}.journey-card image,.journey-shade{position:absolute;inset:0;width:100%;height:100%}.journey-shade{background:linear-gradient(180deg,rgba(14,17,28,.12),rgba(14,17,28,.78))}.journey-info{position:absolute;left:26rpx;right:26rpx;bottom:24rpx;color:#fff}.journey-label{font-size:20rpx;letter-spacing:2rpx}.journey-title{margin-top:6rpx;font-size:34rpx;font-weight:760}.progress-track{height:9rpx;margin-top:18rpx;border-radius:99rpx;background:rgba(255,255,255,.28);overflow:hidden}.progress-fill{height:100%;border-radius:99rpx;background:#ff9b51;transition:width .5s linear}.message{margin-top:15rpx;font-size:24rpx}.section-title{margin:28rpx 4rpx 16rpx;font-size:31rpx;font-weight:750}.destination-card{display:flex;margin-bottom:18rpx;padding:14rpx;border-radius:30rpx;background:#fff;box-shadow:0 10rpx 32rpx rgba(77,54,40,.06)}.destination-card image{width:230rpx;height:190rpx;border-radius:22rpx}.destination-body{display:flex;flex:1;min-width:0;flex-direction:column;padding:10rpx 8rpx 4rpx 20rpx}.destination-name{font-size:29rpx;font-weight:740}.destination-meta{flex:1;margin-top:10rpx;color:#94877f;font-size:20rpx;line-height:1.45}.destination-body button{width:100%;height:60rpx;margin:0;border:0;border-radius:999rpx;background:#ff8a34;color:#fff;font-size:22rpx;line-height:60rpx}.destination-body button::after,.postcard-sheet button::after{border:0}.postcard-grid{display:grid;grid-template-columns:1fr 1fr;gap:16rpx}.souvenir-row{white-space:nowrap}.souvenir{display:inline-flex;width:190rpx;margin-right:16rpx;flex-direction:column;padding:12rpx;border-radius:24rpx;background:#fff}.souvenir image{width:190rpx;height:170rpx;border-radius:18rpx}.souvenir text{padding:12rpx 4rpx 6rpx;font-size:22rpx}.postcard-mask{position:fixed;z-index:100;inset:0;background:rgba(16,15,18,.65)}.postcard-sheet{position:fixed;z-index:101;left:24rpx;right:24rpx;top:50%;overflow:hidden;border-radius:34rpx;background:#fff;transform:translateY(-50%)}.postcard-sheet>image{width:100%;height:410rpx}.postcard-copy{padding:30rpx}.to{color:#8b5cf6;font-size:20rpx;font-weight:700;letter-spacing:1rpx}.postcard-message{margin-top:20rpx;color:#51453f;font-size:28rpx;line-height:1.75}.postcard-sheet button{margin-top:24rpx;border:0;border-radius:999rpx;background:#ff8a34;color:#fff;font-size:24rpx}.postcard-sheet button.close{margin-top:12rpx;background:#f2ece6;color:#6d6059}
