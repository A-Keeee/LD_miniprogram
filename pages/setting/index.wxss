.container {
  min-height: 100vh;
  background-color: #F9FAFB;
  padding: 32rpx 32rpx 140rpx;
}

.card {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
  border: 1rpx solid #f3f4f6;
  margin-bottom: 32rpx;
}

.card-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 28rpx;
}

.card-title {
  font-weight: bold;
  color: #7e22ce;
  font-size: 30rpx;
}

.form-group {
  margin-bottom: 24rpx;
}

.label {
  font-size: 26rpx;
  font-weight: 500;
  color: #374151;
  margin-bottom: 12rpx;
}

.provider-options {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.provider-btn {
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  border: 2rpx solid #e5e7eb;
  background-color: #ffffff;
}

.provider-btn:active {
  opacity: 0.85;
}

.provider-btn.active {
  border-color: #a855f7;
  background-color: #faf5ff;
  box-shadow: 0 0 0 2rpx #a855f7;
}

.p-title {
  font-weight: 500;
  color: #1f2937;
  font-size: 28rpx;
  margin-bottom: 6rpx;
}

.provider-btn.active .p-title {
  color: #7e22ce;
}

.p-desc {
  font-size: 22rpx;
  color: #9ca3af;
  line-height: 1.4;
}

.api-settings {
  padding-top: 12rpx;
}

.input-wrap {
  position: relative;
  display: flex;
  align-items: center;
}

.input-icon {
  position: absolute;
  left: 20rpx;
  z-index: 1;
}

.input-box {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 24rpx 0 56rpx;
  border-radius: 20rpx;
  border: 2rpx solid #e5e7eb;
  background-color: #ffffff;
  font-size: 26rpx;
}

.input-box.no-icon {
  padding-left: 24rpx;
}

.info-box {
  background-color: #eff6ff;
  border-radius: 20rpx;
  padding: 24rpx;
  display: flex;
  gap: 16rpx;
  margin-bottom: 40rpx;
  align-items: flex-start;
}

.info-text {
  flex: 1;
  font-size: 24rpx;
  line-height: 1.6;
  color: #1d4ed8;
}

.save-btn {
  width: 100% !important;
  background-color: #111827 !important;
  color: #ffffff !important;
  padding: 24rpx !important;
  border-radius: 20rpx;
  font-size: 30rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  margin-bottom: 32rpx;
}

.save-btn::after {
  display: none;
}

.save-btn.saved {
  background-color: #22c55e !important;
}

.save-btn:active {
  opacity: 0.85;
}

.pair-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.pair-input {
  flex: 1;
}

.pair-btn {
  flex-shrink: 0;
  margin: 0 !important;
  padding: 0 28rpx !important;
  height: 88rpx !important;
  line-height: 88rpx !important;
  background-color: #7e22ce !important;
  color: #ffffff !important;
  font-size: 26rpx !important;
  border-radius: 20rpx !important;
  border: none !important;
}

.pair-btn::after {
  display: none;
}

.pair-btn[disabled] {
  opacity: 0.5;
}

.device-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.device-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  border: 2rpx solid #e5e7eb;
  background-color: #ffffff;
}

.device-item.active {
  border-color: #a855f7;
  background-color: #faf5ff;
}

.device-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #1f2937;
}

.device-meta {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 6rpx;
}

.device-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.active-tag {
  font-size: 22rpx;
  color: #7e22ce;
  font-weight: 500;
}

.unbind-btn {
  font-size: 22rpx;
  color: #ef4444;
}

.empty-devices {
  font-size: 24rpx;
  color: #9ca3af;
  line-height: 1.6;
  padding: 8rpx 0;
}

.cache-section {
  margin-top: 32rpx;
  padding-top: 28rpx;
  border-top: 2rpx solid #f3f4f6;
}

.cache-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 20rpx;
  flex-wrap: wrap;
}

.cache-title-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.cache-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2937;
}

.cache-summary {
  font-size: 22rpx;
  color: #7e22ce;
  font-weight: 500;
}

.cache-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.cache-all-btn {
  flex-shrink: 0;
  min-width: 128rpx;
  height: 52rpx !important;
  line-height: 52rpx !important;
  margin: 0 !important;
  padding: 0 18rpx !important;
  border-radius: 999rpx !important;
  background-color: #7e22ce !important;
  color: #ffffff !important;
  font-size: 22rpx !important;
  font-weight: 500;
  border: none !important;
}

.cache-all-btn::after {
  display: none;
}

.cache-all-btn[disabled] {
  opacity: 0.45;
}

.cache-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.cache-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 18rpx 22rpx;
  border-radius: 18rpx;
  background-color: #f9fafb;
}

.cache-item-main {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.cache-name {
  font-size: 24rpx;
  color: #374151;
  white-space: nowrap;
}

.cache-tag {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #6b7280;
  background-color: #f3f4f6;
  border-radius: 999rpx;
  padding: 6rpx 14rpx;
}

.cache-tag.cached {
  color: #15803d;
  background-color: #dcfce7;
}

.cache-item-btn {
  flex-shrink: 0;
  width: 120rpx !important;
  height: 52rpx !important;
  line-height: 52rpx !important;
  margin: 0 !important;
  padding: 0 !important;
  border-radius: 999rpx !important;
  background-color: #111827 !important;
  color: #ffffff !important;
  font-size: 22rpx !important;
  font-weight: 500;
  border: none !important;
}

.cache-item-btn::after {
  display: none;
}

.cache-item-btn.cached {
  background-color: #e5e7eb !important;
  color: #6b7280 !important;
}

.cache-item-btn[disabled] {
  opacity: 0.55;
}

.cache-empty {
  font-size: 22rpx;
  color: #9ca3af;
  line-height: 1.5;
  padding: 12rpx 0 4rpx;
}

.account-card {
  margin-top: 32rpx;
}

.account-desc {
  font-size: 24rpx;
  line-height: 1.5;
  color: #6b7280;
  margin-bottom: 24rpx;
}

.logout-btn {
  width: 100% !important;
  margin: 0 !important;
  padding: 24rpx !important;
  border-radius: 20rpx !important;
  background-color: #ef4444 !important;
  color: #ffffff !important;
  font-size: 28rpx !important;
  font-weight: 600;
  border: none !important;
}

.logout-btn::after {
  display: none;
}

.logout-btn:active {
  opacity: 0.85;
}

.logout-btn[disabled] {
  opacity: 0.65;
}
