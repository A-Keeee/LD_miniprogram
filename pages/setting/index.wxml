<view class="container">
  <view class="card">
    <view class="card-header">
      <t-icon name="link" size="20px" color="#7e22ce" />
      <text class="card-title">我的设备</text>
    </view>

    <view class="form-group">
      <view class="label">配对码</view>
      <view class="pair-row">
        <input
          class="input-box no-icon pair-input"
          placeholder="输入 6 位配对码"
          maxlength="6"
          value="{{pairingCode}}"
          bindinput="onPairingCodeInput"
        />
        <button
          class="pair-btn"
          bindtap="handlePair"
          disabled="{{isPairing || !pairingCode || !petName || !petImageDataUrl}}"
          loading="{{isPairing}}"
        >配对</button>
      </view>
    </view>

    <view class="form-group">
      <view class="label">宠物昵称</view>
      <input
        class="input-box no-icon"
        placeholder="例如：糯米"
        value="{{petName}}"
        bindinput="onPetNameInput"
      />
    </view>

    <view class="type-selector">
      <view class="type-btn {{petType === 'cat' ? 'active' : ''}}" data-type="cat" bindtap="selectPetType">
        <text class="emoji">🐱</text>
        <text>猫咪</text>
      </view>
      <view class="type-btn {{petType === 'dog' ? 'active' : ''}}" data-type="dog" bindtap="selectPetType">
        <text class="emoji">🐶</text>
        <text>狗狗</text>
      </view>
    </view>

    <view class="form-group">
      <view class="label">宠物照片（用于生成数字分身）</view>
      <view class="upload-area" bindtap="choosePetImage">
        <image wx:if="{{petImage}}" src="{{petImage}}" mode="aspectFill" class="preview-img"></image>
        <view wx:else class="upload-placeholder">
          <t-icon name="upload" size="32px" color="#9ca3af" />
          <text>点击上传照片</text>
        </view>
      </view>
    </view>

    <view class="device-list" wx:if="{{devices.length > 0}}">
      <view
        wx:for="{{devices}}"
        wx:key="device_id"
        class="device-item {{activeDeviceId === item.device_id ? 'active' : ''}}"
        data-id="{{item.device_id}}"
        bindtap="handleSelectDevice"
      >
        <view class="device-main">
          <view class="device-name">{{item.pet_name || item.name || item.device_id}}</view>
          <view class="device-meta">{{item.device_id}} · 最后在线 {{item.lastSeenText}}</view>
        </view>
        <view class="device-actions">
          <text wx:if="{{activeDeviceId === item.device_id}}" class="active-tag">当前</text>
          <text
            class="unbind-btn"
            data-id="{{item.device_id}}"
            catchtap="handleUnbind"
          >解绑</text>
        </view>
      </view>
    </view>

    <view class="empty-devices" wx:elif="{{!isLoadingDevices}}">
      暂无绑定设备，请先注册硬件/Mock 设备，输入配对码并创建宠物
    </view>
  </view>

  <view class="card">
    <view class="card-header">
      <t-icon name="server" size="20px" color="#7e22ce" />
      <text class="card-title">视频内容设置</text>
    </view>
    
    <view class="form-group">
      <view class="label">提供商 (Provider)</view>
      <view class="provider-options">
        <view 
          class="provider-btn {{settings.provider === 'LOCAL' ? 'active' : ''}}" 
          data-provider="LOCAL" 
          bindtap="setProvider"
        >
          <view class="p-title">本地预设 (Local)</view>
          <view class="p-desc">使用预置/远程备链演示视频</view>
        </view>
        <view 
          class="provider-btn {{settings.provider === 'KLING_AI' ? 'active' : ''}}" 
          data-provider="KLING_AI" 
          bindtap="setProvider"
        >
          <view class="p-title">AI 短视频生成</view>
          <view class="p-desc">通过 AI 自动生成动态视频（未开放）</view>
        </view>
      </view>
    </view>

    <!-- API Settings section shown if KLING_AI -->
    <view class="api-settings" wx:if="{{settings.provider === 'KLING_AI'}}">
      <view class="form-group">
        <view class="label">API Key</view>
        <view class="input-wrap">
          <t-icon name="lock-on" size="16px" color="#9ca3af" class="input-icon" />
          <input 
            class="input-box" 
            password="{{true}}" 
            placeholder="sk-..." 
            value="{{settings.apiKey}}" 
            data-field="apiKey"
            bindinput="handleInput"
          />
        </view>
      </view>
      
      <view class="form-group">
        <view class="label">模型名称 (Model)</view>
        <view class="input-wrap">
          <t-icon name="app" size="16px" color="#9ca3af" class="input-icon" />
          <input 
            class="input-box" 
            placeholder="例如: kling-v1" 
            value="{{settings.modelName}}" 
            data-field="modelName"
            bindinput="handleInput"
          />
        </view>
      </view>

      <view class="form-group">
        <view class="label">Endpoint (可选)</view>
        <input 
          class="input-box no-icon" 
          placeholder="https://..." 
          value="{{settings.apiEndpoint}}" 
          data-field="apiEndpoint"
          bindinput="handleInput"
        />
      </view>
    </view>
  </view>
  
  <view class="info-box">
    <t-icon name="info-circle" size="18px" color="#1d4ed8" />
    <view class="info-text">
      注：对话功能的 AI API 已在代码中作为内嵌设置，当前页面仅用于配置视频生成接口。
    </view>
  </view>
  
  <button class="save-btn {{saved ? 'saved' : ''}}" bindtap="handleSave">
    <t-icon wx:if="{{!saved}}" name="save" size="20px" color="#ffffff" />
    <text style="margin-left:8px;">{{saved ? '已保存!' : '保存设置'}}</text>
  </button>
</view>
